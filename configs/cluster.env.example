# Optional cluster settings. Copy to .local/cluster.env (ignored by Git).
# Existing environment variables take precedence in this example.
export NCCL_SOCKET_IFNAME="${NCCL_SOCKET_IFNAME:-eth0}"
export GLOO_SOCKET_IFNAME="${GLOO_SOCKET_IFNAME:-eth0}"
# export NCCL_LIB_DIR=/path/to/nvidia/nccl/lib
# export PROXY_URL=http://proxy.example:8080
# export no_proxy=localhost,127.0.0.1,.example.internal
export MASTER_PORT="${MASTER_PORT:-29500}"
export RENDEZVOUS_TIMEOUT="${RENDEZVOUS_TIMEOUT:-600}"
export MIXED_PRECISION="${MIXED_PRECISION:-bf16}"
# Set MASTER_FILE only when the repository's outputs/ directory is not shared.
# export MASTER_FILE=/shared/training/my-run/master.json
